# Copy to .env (gitignored) — `make bakeoff-matrix` / langfuse-* auto-load it.
# Any var also set in your shell overrides the file.

# --- Langfuse Cloud (takes the local 6-container stack off your RAM) ---
LANGFUSE_HOST=https://cloud.langfuse.com          # or https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx

# --- Model API keys (bake-off runs a cloud cell only if its key is present) ---
# LLM_GEMINI_API_KEY=...            # Google AI Studio (free tier)
# ANTHROPIC_API_KEY=...             # Claude tiers (needs credit)
# AWS_ACCESS_KEY_ID=...             # Nova / Bedrock
# AWS_SECRET_ACCESS_KEY=...
# LLM_BEDROCK_REGION=eu-central-1

# Local Ollama is key-free; base URL only needed if not the default:
# LLM_OPENAI_BASE_URL=http://localhost:11434/v1
